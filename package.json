{
  "name": "genkit",
  "version": "1.0.0",
  "description": "GenKit: turn any deployed GenLayer contract's on-chain schema into a typed, documented SDK.",
  "type": "module",
  "bin": {
    "genkit": "./cli/genkit.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "generate": "node cli/genkit.js generate",
    "publish": "node cli/genkit.js publish",
    "registry": "node cli/genkit.js registry"
  },
  "keywords": [
    "genlayer",
    "sdk",
    "codegen",
    "schema",
    "intelligent-contracts"
  ],
  "license": "MIT",
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "ethers": "^6.17.0",
    "genlayer-js": "^1.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "vite": "^5.4.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.4"
  }
}
